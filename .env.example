# ========================================
# SUPABASE - Autenticación y Base de datos
# ========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ========================================
# HUGGING FACE - Modelos de IA Open Source
# ========================================
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
# Modelos recomendados:
# - Chat: mistralai/Mistral-7B-Instruct-v0.1
# - Image Generation: runwayml/stable-diffusion-v1-5
# - Video Animation: damo-vilab/text-to-video-ms-1.7b

# ========================================
# STRIPE - Pagos y Suscripciones
# ========================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ========================================
# VERCEL - Deployment
# ========================================
VERCEL_URL=your-app.vercel.app
NEXT_PUBLIC_API_URL=https://your-app.vercel.app

# ========================================
# CRÉDITOS Y TARIFAS
# ========================================
# Costo de créditos por operación
CREDITS_COST_CHAT=1
CREDITS_COST_IMAGE_GENERATION=5
CREDITS_COST_VIDEO_ANIMATION=10
CREDITS_COST_INFLUENCER_CHAT=3

# Plan de suscripción inicial (créditos mensuales)
CREDITS_FREE_PLAN=50
CREDITS_PRO_PLAN=500
CREDITS_PREMIUM_PLAN=2000

# ========================================
# CONFIGURACIÓN DE SEGURIDAD
# ========================================
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=https://your-app.vercel.app

# ========================================
# CONFIGURACIÓN DE BASE DE DATOS
# ========================================
DATABASE_URL=postgresql://user:password@host:5432/database

# ========================================
# CONFIGURACIÓN DE MODELOS LOCALES (Opcional)
# ========================================
# Si quieres usar modelos locales sin HuggingFace
USE_LOCAL_MODELS=false
LOCAL_MODEL_PATH=./models

# ========================================
# LOGGING Y DEBUG
# ========================================
NODE_ENV=development
DEBUG=false
LOG_LEVEL=info
